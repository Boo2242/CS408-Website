[Unit]
Description=Pikmin Bloom Helper Flask Application
After=network.target

[Service]
Type=simple

# Run as the unprivileged user we created in setup-ec2.sh
User=pikmin
Group=pikmin

WorkingDirectory=/opt/pikmin-helper

# Use the virtual environment's gunicorn binary to run Flask
ExecStart=/opt/pikmin-helper/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 app:app

Environment=FLASK_ENV=production

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

# Hardening: restrict writing to the data folder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pikmin-helper/data

[Install]
WantedBy=multi-user.target