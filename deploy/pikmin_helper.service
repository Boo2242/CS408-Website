[Unit]
Description=Pikmin Bloom Helper Flask Application
After=network.target network-online.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/pikmin-helper
Environment="DATABASE_URL=postgresql://pikmin_user:pikmin_password123@localhost/pikmin_db"
Environment="SECRET_KEY=79367d088dbba4c22a28aaa4276f3e95b8fc6203f0b598e3984aac144970db62"
Environment="FLASK_ENV=production"
ExecStart=/opt/pikmin-helper/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 app:app

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target